# Obsidian REST API URL — use https:// if the plugin runs with HTTPS (default port 27124 uses HTTPS)
OBSIDIAN_REST_API_URL=http://localhost:27123

# API key from Obsidian → Settings → Community plugins → Local REST API
OBSIDIAN_REST_API_KEY=your-api-key-here

# Root folder inside your Obsidian vault (default: AI-Chats)
VAULT_ROOT=AI-Chats
